# SkyGuard AI Environment Variables

# VITE_API_URL: The URL of the FastAPI backend for the frontend to connect to.
# Used in production (e.g., Vercel) to point to the hosted backend (e.g., Render).
VITE_API_URL="https://skyguard-api.onrender.com"

# FRONTEND_URL: The URL of the hosted frontend (e.g., Vercel).
# Used by the FastAPI backend to configure CORS allowed origins.
FRONTEND_URL="https://skyguard-ai.vercel.app"
